#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

export PATH=$PATH:/usr/bin:/usr/sbin:/bin:/sbin

# 按 CPU 架构选择对应二进制（包内内置 amd64 / arm64 两份）
select_binary() {
    case "$(uname -m)" in
        x86_64|amd64)  echo "${TRIM_APPDEST}/server/xbox-amd64" ;;
        aarch64|arm64) echo "${TRIM_APPDEST}/server/xbox-arm64" ;;
        *)             echo "" ;;
    esac
}

BIN="$(select_binary)"
if [ -z "$BIN" ] || [ ! -x "$BIN" ]; then
    echo "Unsupported architecture: $(uname -m)" > "$TRIM_TEMP_LOGFILE"
    exit 1
fi

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

start_process() {
    if status; then
        return 0
    fi

    log_msg "Starting X-Box (arch=$(uname -m)) ..."

    # XBOX_DATA 指向持久数据卷：access_token / info.log 落于此处
    ( export XBOX_DATA="${TRIM_PKGVAR}" && cd "${TRIM_PKGVAR}" && exec "${BIN}" ) >> "${LOG_FILE}" 2>&1 &
    printf "%s" "$!" > "${PID_FILE}"

    sleep 2
    local pid
    pid=$(head -n1 "${PID_FILE}" | tr -d '[:space:]')
    if check_process "${pid}"; then
        log_msg "X-Box started (pid=${pid})"
        log_msg "首次使用请从本日志或 ${TRIM_PKGVAR}/access_token 获取访问令牌"
    else
        log_msg "X-Box failed to start; see ${LOG_FILE}"
        rm -f "${PID_FILE}"
    fi
    return 0
}

stop_process() {
    log_msg "Stopping X-Box ..."

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')

        if ! check_process "${pid}"; then
            rm -f "${PID_FILE}"
            return 0
        fi

        log_msg "send TERM to PID:${pid}"
        kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1

        local count=0
        while check_process "${pid}" && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
        done

        if check_process "${pid}"; then
            log_msg "send KILL to PID:${pid}"
            kill -KILL "${pid}"
        else
            log_msg "process terminated"
        fi
        rm -f "${PID_FILE}"
    fi

    return 0
}

check_process() {
    local pid=$1
    [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        fi
        rm -f "${PID_FILE}"
    fi

    # 兜底：进程在跑但 pid 文件丢失
    if pgrep -f "${TRIM_APPDEST}/server/xbox" > /dev/null 2>&1; then
        pgrep -f "${TRIM_APPDEST}/server/xbox" | head -n1 > "${PID_FILE}"
        return 0
    fi

    return 1
}

case "$1" in
    start)
        start_process
        ;;
    stop)
        stop_process
        ;;
    status)
        if status; then
            exit 0
        fi
        exit 3
        ;;
    *)
        exit 1
        ;;
esac
